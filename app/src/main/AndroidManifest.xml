<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      TRANSMIT_IR is a normal permission: it is granted at install time and
      there is no runtime prompt to request. It is the only permission this app
      needs, and it needs no network, storage or location access at all.
    -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />

    <!--
      Declared as not required so the app still installs on phones without a
      blaster; the UI reports the missing emitter instead of refusing to run.
      Set this to true if you would rather Play Store hid the app from devices
      that cannot use it.
    -->
    <uses-feature
        android:name="android.hardware.consumerir"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediaStarRemote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.MediaStarRemote"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
