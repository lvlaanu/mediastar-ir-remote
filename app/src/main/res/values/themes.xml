<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launch theme only has to bridge the gap until Compose draws. It is
      kept dark so there is no white flash before the black handset appears.
    -->
    <style name="Theme.MediaStarRemote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/backdrop</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
