<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and earlier backup. The DataStore file holding the code profiles
  is the only thing worth keeping, and it is the thing a user would be most
  annoyed to lose after a long Discovery session.
-->
<full-backup-content>
    <include
        domain="file"
        path="datastore/mediastar_profiles.preferences_pb" />
</full-backup-content>
